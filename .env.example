# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
# Server only. Never expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string. The deletion cron sends it as a Bearer token.
CRON_SECRET=
# Days after a report link is used before personal data is deleted
RETENTION_DAYS=7
# Gemini API key (Google AI Studio). Without it, reports use the built-in template.
GEMINI_API_KEY=
# Optional model override
GEMINI_MODEL=gemini-3.8-flash
# Optional lighter backup model, used when the main one is busy. Leave as is unless a model is retired.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Password for /admin (founder view). Leave empty to keep admin closed.
ADMIN_PASSWORD=
# Public site address, used in the links sent to customers
NEXT_PUBLIC_SITE_URL=
# Shown on the privacy page for access and deletion requests (an email or WhatsApp number)
NEXT_PUBLIC_CONTACT=
# ---- Affiliate links (optional, web report only; the PDF keeps plain links) ----
# Amazon Associates tracking id:
AMAZON_ASSOCIATE_TAG=
# For Myntra, Ajio, Flipkart: paste the redirect link your affiliate network gives you, with {url} where the shop address goes.
AFFILIATE_MYNTRA_TEMPLATE=
AFFILIATE_AJIO_TEMPLATE=
AFFILIATE_FLIPKART_TEMPLATE=

# Thank-you email for the waitlist (Gmail). Use a Google App Password, not your normal password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_DAILY_LIMIT=400
